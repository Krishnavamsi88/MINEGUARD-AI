<?xml version="1.0"?>
<sdf version="1.9">
  <model name="HEMM_Dumper_01">
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>

    <!-- ============================================================
         CHASSIS (Central Frame)
         Pose: center at (0, 0, 1.25)
         Dimensions: length=8.0m, width=2.8m, height=1.0m
         - Bottom at z=0.75m (75cm ground clearance above road surface z=0)
         - Top at z=1.75m
         - Width 2.8m sits cleanly between wheels (wheel inner edges at y=±1.50m)
           preventing any chassis-wheel collision or clipping.
         ============================================================ -->
    <link name="chassis">
      <pose>0 0 1.25 0 0 0</pose>
      <inertial>
        <mass>9000</mass>
        <inertia>
          <ixx>6630</ixx><iyy>48750</iyy><izz>53880</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>8.0 2.8 1.0</size></box></geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.05</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>8.0 2.8 1.0</size></box></geometry>
        <material>
          <ambient>0.95 0.65 0.05 1</ambient>
          <diffuse>0.95 0.65 0.05 1</diffuse>
        </material>
      </visual>

      <!-- IMU Sensor on Chassis -->
      <sensor name="imu" type="imu">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <visualize>true</visualize>
        <topic>/imu</topic>
      </sensor>

      <!-- GPS / NavSat Sensor on Chassis -->
      <sensor name="gps" type="navsat">
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <topic>/gps</topic>
      </sensor>
    </link>

    <!-- Front cab (fixed to chassis) -->
    <link name="front_body">
      <pose>2.45 0 2.35 0 0 0</pose>
      <inertial>
        <mass>1800</mass>
        <inertia>
          <ixx>1902</ixx><iyy>1452</iyy><izz>1902</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>2.2 2.8 2.2</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>2.2 2.8 2.2</size></box></geometry>
        <material>
          <ambient>0.95 0.65 0.05 1</ambient>
          <diffuse>0.95 0.65 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Dump bed (fixed to chassis) -->
    <link name="dump_bed">
      <pose>-1.35 0 2.15 0 0 0</pose>
      <inertial>
        <mass>1400</mass>
        <inertia>
          <ixx>1177</ixx><iyy>2625</iyy><izz>3277</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>4.5 2.8 1.5</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>4.5 2.8 1.5</size></box></geometry>
        <material>
          <ambient>0.85 0.55 0.03 1</ambient>
          <diffuse>0.85 0.55 0.03 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Sensor mast (fixed to chassis) -->
    <link name="sensor_mast">
      <pose>0 0 3.15 0 0 0</pose>
      <inertial>
        <mass>80</mass>
        <inertia>
          <ixx>20</ixx><iyy>20</iyy><izz>20</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.10</radius><length>1.0</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>

    <!-- ============================================================
         FOUR PHYSICAL WHEELS
         Wheel radius = 0.70m, cylinder length = 0.50m
         Link pose: z=0.70m -> wheel bottom is at z=0.00m (exact road contact)
         Orientation: rpy=1.5707963 0 0 aligns cylinder axis with world Y (lateral)
         Inertia in link frame (cylinder along local Z):
           ixx = iyy = m*(3*r^2 + h^2)/12, izz = m*r^2/2
         ============================================================ -->

    <!-- Left Front Wheel -->
    <link name="left_front_wheel">
      <pose>2.65 1.75 0.70 1.5707963 0 0</pose>
      <inertial>
        <mass>450</mass>
        <inertia>
          <ixx>65</ixx><iyy>65</iyy><izz>110</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.70</radius><length>0.50</length></cylinder></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>0.05</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000</kp>
              <kd>100</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.70</radius><length>0.50</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
    </link>

    <!-- Right Front Wheel -->
    <link name="right_front_wheel">
      <pose>2.65 -1.75 0.70 1.5707963 0 0</pose>
      <inertial>
        <mass>450</mass>
        <inertia>
          <ixx>65</ixx><iyy>65</iyy><izz>110</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.70</radius><length>0.50</length></cylinder></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>0.05</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000</kp>
              <kd>100</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.70</radius><length>0.50</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
    </link>

    <!-- Left Rear Wheel -->
    <link name="left_rear_wheel">
      <pose>-2.65 1.75 0.70 1.5707963 0 0</pose>
      <inertial>
        <mass>500</mass>
        <inertia>
          <ixx>72</ixx><iyy>72</iyy><izz>122</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.70</radius><length>0.50</length></cylinder></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>0.05</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000</kp>
              <kd>100</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.70</radius><length>0.50</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
    </link>

    <!-- Right Rear Wheel -->
    <link name="right_rear_wheel">
      <pose>-2.65 -1.75 0.70 1.5707963 0 0</pose>
      <inertial>
        <mass>500</mass>
        <inertia>
          <ixx>72</ixx><iyy>72</iyy><izz>122</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.70</radius><length>0.50</length></cylinder></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>0.05</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000</kp>
              <kd>100</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.70</radius><length>0.50</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
    </link>

    <!-- ============================================================
         REVOLUTE JOINTS
         Joint axes rotate around world Y (expressed_in="__model__")
         Joint anchors sit at the wheel centers (no offset pose)
         ============================================================ -->
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>chassis</parent><child>left_front_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1e16</lower><upper>1e16</upper>
          <effort>30000</effort><velocity>20</velocity>
        </limit>
        <dynamics><damping>50</damping><friction>1.0</friction></dynamics>
      </axis>
    </joint>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>chassis</parent><child>right_front_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1e16</lower><upper>1e16</upper>
          <effort>30000</effort><velocity>20</velocity>
        </limit>
        <dynamics><damping>50</damping><friction>1.0</friction></dynamics>
      </axis>
    </joint>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent><child>left_rear_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1e16</lower><upper>1e16</upper>
          <effort>30000</effort><velocity>20</velocity>
        </limit>
        <dynamics><damping>50</damping><friction>1.0</friction></dynamics>
      </axis>
    </joint>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent><child>right_rear_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1e16</lower><upper>1e16</upper>
          <effort>30000</effort><velocity>20</velocity>
        </limit>
        <dynamics><damping>50</damping><friction>1.0</friction></dynamics>
      </axis>
    </joint>

    <!-- Fixed body joints -->
    <joint name="front_body_joint" type="fixed">
      <parent>chassis</parent><child>front_body</child>
    </joint>
    <joint name="dump_bed_joint" type="fixed">
      <parent>chassis</parent><child>dump_bed</child>
    </joint>
    <joint name="sensor_mast_joint" type="fixed">
      <parent>chassis</parent><child>sensor_mast</child>
    </joint>

    <!-- ============================================================
         DIFFERENTIAL DRIVE PLUGIN
         Topics: /cmd_vel and /odom (matching ros_gz_bridge standard setup)
         ============================================================ -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>3.50</wheel_separation>
      <wheel_radius>0.70</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration>
      <min_angular_acceleration>-1.5</min_angular_acceleration>
    </plugin>
    <!-- ==================== LiDAR SENSOR (360° Horizontal Scan) ==================== -->
    <link name="lidar_link">
      <pose>4.05 0 0.85 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.15</radius><length>0.15</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>50.0</max>
            <resolution>0.05</resolution>
          </range>
        </ray>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>chassis</parent>
      <child>lidar_link</child>
    </joint>

    <!-- ==================== FRONT CAMERAS (RGB & Depth) ==================== -->
    <link name="camera_link">
      <pose>3.55 0 2.5 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0005</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.15 0.30 0.15</size></box></geometry>
        <material><ambient>0.2 0.2 0.8 1</ambient><diffuse>0.2 0.2 0.8 1</diffuse></material>
      </visual>

      <!-- Front-facing RGB Camera -->
      <sensor name="camera" type="camera">
        <topic>/camera/image_raw</topic>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.570796</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.2</near>
            <far>100.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>

      <!-- Front-facing Depth Camera -->
      <sensor name="depth_camera" type="depth_camera">
        <topic>/depth/image_raw</topic>
        <update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.396263</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.5</near>
            <far>50.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>chassis</parent>
      <child>camera_link</child>
    </joint>
  </model>
</sdf>
