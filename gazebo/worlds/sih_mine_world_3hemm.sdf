    <!-- ================================================================
         HEMM_Dumper_01  |  Namespace: /hemm_01
         Spawn: x=-60, y=87.5, z=0, yaw=0.0000 rad
         ================================================================ -->
    <model name="HEMM_Dumper_01">
      <pose>-60 85.0 0 0 0 0.0</pose>
      <self_collide>false</self_collide>

      <!-- Chassis -->
      <link name="chassis">
        <pose>0 0 1.25 0 0 0</pose>
        <inertial>
          <mass>9000</mass>
          <inertia><ixx>6630</ixx><iyy>48750</iyy><izz>53880</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>8.0 2.8 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.05</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.0 2.8 1.0</size></box></geometry>
          <material><ambient>0.95 0.65 0.05 1</ambient><diffuse>0.95 0.65 0.05 1</diffuse></material>
        </visual>
        <!-- IMU -->
        <sensor name="imu" type="imu">
          <always_on>1</always_on><update_rate>50</update_rate><visualize>false</visualize>
          <topic>/hemm_01/imu</topic>
        </sensor>
        <!-- GPS -->
        <sensor name="gps" type="navsat">
          <always_on>1</always_on><update_rate>5</update_rate>
          <topic>/hemm_01/gps</topic>
        </sensor>
      </link>

      <!-- Front cab -->
      <link name="front_body">
        <pose>2.45 0 2.35 0 0 0</pose>
        <inertial><mass>1800</mass><inertia><ixx>1902</ixx><iyy>1452</iyy><izz>1902</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>2.2 2.8 2.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.2 2.8 2.2</size></box></geometry>
          <material><ambient>0.95 0.65 0.05 1</ambient><diffuse>0.95 0.65 0.05 1</diffuse></material>
        </visual>
      </link>

      <!-- Dump bed -->
