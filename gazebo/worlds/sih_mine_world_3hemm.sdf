        <pose>-1.35 0 2.15 0 0 0</pose>
        <inertial><mass>1400</mass><inertia><ixx>1177</ixx><iyy>2625</iyy><izz>3277</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
